<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<!-- Idle / Start Screen: logo + "Tap to Start" button -->
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.boothyeah.controller.IdleController"
           styleClass="root-pane" fx:id="rootPane">

    <VBox alignment="CENTER" spacing="50">
        <padding><Insets top="50" bottom="50" left="50" right="50"/></padding>

        <!-- App Logo / The Photobooth Co. -->
        <Label text="The Photobooth Co." styleClass="heading" fx:id="titleLabel"
               style="-fx-font-size: 100px;"/>

        <Label text="Capturing Smiles. Capturing Memories." styleClass="heading-sm"
               style="-fx-text-fill: #000000; -fx-letter-spacing: 10;"/>

        <!-- Tap to Start Button -->
        <Button text="Tap to Start" styleClass="btn-primary" fx:id="startButton"
                onAction="#onStartTapped"
                style="-fx-font-size: 32px; -fx-padding: 20 60;"/>
    </VBox>


    <!-- Inline PIN overlay (replaces modal dialog that freezes in fullscreen) -->
    <StackPane fx:id="pinOverlay" visible="false" managed="false"
               style="-fx-background-color: rgba(0, 0, 0, 0.85);">
        <VBox alignment="CENTER" spacing="25" maxWidth="400">
            <Label text="🔒  Admin Access" styleClass="heading-sm" style="-fx-text-fill: #FFD700;"/>
            <Label text="Enter Admin PIN" styleClass="body-text"/>
            <PasswordField fx:id="pinField" styleClass="admin-field" promptText="PIN"
                           style="-fx-font-size: 24px; -fx-padding: 15; -fx-alignment: center; -fx-max-width: 250;"/>
            <Label fx:id="pinErrorLabel" text="" style="-fx-text-fill: #ff4444; -fx-font-size: 14px;"/>
            <HBox alignment="CENTER" spacing="20">
                <Button text="Cancel" styleClass="btn-secondary" onAction="#onPinCancel"
                        style="-fx-font-size: 18px; -fx-padding: 12 30;"/>
                <Button text="Enter" styleClass="btn-primary" onAction="#onPinSubmit"
                        style="-fx-font-size: 18px; -fx-padding: 12 30;"/>
            </HBox>
        </VBox>
    </StackPane>
</StackPane>
