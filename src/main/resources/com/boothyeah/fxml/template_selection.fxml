<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!-- Template Selection Screen: shows available templates as clickable cards -->
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.boothyeah.controller.TemplateController"
            styleClass="root-pane" fx:id="rootPane">

    <!-- Title at top -->
    <top>
        <VBox alignment="CENTER" spacing="10">
            <padding><Insets top="40" bottom="20" left="40" right="40"/></padding>
            <Label text="Choose Your Template" styleClass="heading"/>
            <Label text="SELECT A PHOTO STRIP DESIGN" styleClass="body-text"/>
        </VBox>
    </top>

    <!-- Template grid in center -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <FlowPane fx:id="templateGrid" alignment="CENTER" hgap="30" vgap="30">
                <padding><Insets top="20" bottom="40" left="60" right="60"/></padding>
            </FlowPane>
        </ScrollPane>
    </center>

    <!-- Back button at bottom -->
    <bottom>
        <HBox alignment="CENTER" spacing="20">
            <padding><Insets top="20" bottom="40"/></padding>
            <Button text="← Back" styleClass="btn-secondary" onAction="#onBack"/>
        </HBox>
    </bottom>
</BorderPane>
